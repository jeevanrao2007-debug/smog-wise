{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint src server.ts firestore.rules --max-warnings 0",
    "lint:rules": "eslint firestore.rules",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" server.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" server.ts",
    "test": "tsx --test src/utils/smogLogic.test.ts src/utils/impactModel.test.ts src/utils/apiIntegration.test.ts src/utils/firestoreRules.test.ts src/utils/accessibilityAndLazy.test.ts src/utils/securityAndEfficiency.test.ts src/utils/geminiClient.test.ts src/utils/componentsAndHooks.test.ts",
    "test:rules:emulator": "tsx --test tests/firestore.emulator.test.ts",
    "test:e2e": "bash e2e/run-e2e.sh"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.74.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
